{
  "name": "recurring-bill",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app && node scripts/sign-macos.mjs",
    "desktop:universal": "tauri build --target universal-apple-darwin --bundles app && node scripts/sign-macos.mjs universal-apple-darwin",
    "package:macos": "node scripts/package-macos.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
